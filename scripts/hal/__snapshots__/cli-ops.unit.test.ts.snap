// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`plists > nightly: 01:00 default, caffeinate, npm run hal -- run --nightly, escaped (snapshot) 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gstudio.hal.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-is</string>
    <string>/opt/node &amp; co/bin/npm</string>
    <string>run</string>
    <string>hal</string>
    <string>--</string>
    <string>run</string>
    <string>--nightly</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/a&lt;b&gt;/repo</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/node &amp; co/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>1</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/a&lt;b&gt;/repo/.data/hal/logs/nightly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/a&lt;b&gt;/repo/.data/hal/logs/nightly.log</string>
</dict>
</plist>
"
`;

exports[`plists > server: KeepAlive, serve --lan --quiet (snapshot) 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gstudio.hal.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/node &amp; co/bin/npm</string>
    <string>run</string>
    <string>hal</string>
    <string>--</string>
    <string>serve</string>
    <string>--lan</string>
    <string>--quiet</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/a&lt;b&gt;/repo</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/node &amp; co/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
