{
  "name": "studio-in-a-box",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "services/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/sdk adapters/local services/api",
    "lint:infra": "az bicep build --file infra/main.bicep --stdout > /dev/null"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
