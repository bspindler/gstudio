{
  "name": "studio-in-a-box",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "services/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/sdk adapters/local services/api && tsc -p scripts",
    "lint:infra": "az bicep build --file infra/main.bicep --stdout > /dev/null",
    "dev": "tsx scripts/dev.ts",
    "seed": "tsx scripts/seed.ts",
    "rollup": "tsx scripts/rollup.ts",
    "gates": "tsx scripts/gates.ts",
    "demo:1b": "tsx scripts/demo-1b.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
