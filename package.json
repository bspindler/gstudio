{
  "name": "studio-in-a-box",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "services/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/sdk adapters/local services/api && tsc -p scripts",
    "lint:infra": "tsx scripts/bicep-lint.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:lan": "tsx scripts/dev.ts --lan",
    "seed": "tsx scripts/seed.ts",
    "rollup": "tsx scripts/rollup.ts",
    "gates": "tsx scripts/gates.ts",
    "hal": "tsx scripts/hal.ts",
    "new-game": "tsx scripts/new-game.ts",
    "build:pages": "tsx scripts/build-pages.ts",
    "demo:1b": "tsx scripts/demo-1b.ts",
    "ci:local": "tsx scripts/ci-local.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "playwright": "^1.65.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
