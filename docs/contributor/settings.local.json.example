{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run dev)",
      "Bash(npm run dev:lan)",
      "Bash(npm run new-game:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(npm test)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run dev:lan)",
      "PowerShell(npm run new-game:*)",
      "PowerShell(git status)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main:*)",
      "Edit(policy.yaml)",
      "Edit(markets.yaml)",
      "Edit(infra/**)"
    ]
  }
}
